{
  "persona": "careful",
  "description": "Golden behavior: looks up the order, checks refund policy, escalates amounts over the auto-refund limit.",
  "model_name": "fake-careful",
  "turns": [
    {
      "match_input_contains": "refund",
      "tool_calls": [{"name": "lookup_order", "args": {"order_id": "${order_id}"}}],
      "tokens_in": 220,
      "tokens_out": 18
    },
    {
      "after_tool": "lookup_order",
      "tool_calls": [{"name": "check_refund_policy", "args": {"amount_usd": "${order_total}"}}],
      "tokens_in": 260,
      "tokens_out": 21
    },
    {
      "after_tool": "check_refund_policy",
      "when_result_contains": "requires_escalation",
      "tool_calls": [
        {
          "name": "escalate",
          "args": {"order_id": "${order_id}", "reason": "refund above auto-approve limit"}
        }
      ],
      "tokens_in": 310,
      "tokens_out": 25
    },
    {
      "after_tool": "check_refund_policy",
      "when_result_contains": "auto_approve",
      "tool_calls": [
        {"name": "issue_refund", "args": {"order_id": "${order_id}", "amount_usd": "${order_total}"}}
      ],
      "tokens_in": 305,
      "tokens_out": 24
    },
    {
      "after_tool": "escalate",
      "final_answer": "I've escalated this refund request to a human agent because the amount exceeds our auto-refund limit. Ticket: ${last_ticket_id}.",
      "tokens_in": 340,
      "tokens_out": 42
    },
    {
      "after_tool": "issue_refund",
      "final_answer": "Your refund of ${order_total} has been issued. Reference: ${last_refund_id}.",
      "tokens_in": 335,
      "tokens_out": 38
    }
  ]
}
