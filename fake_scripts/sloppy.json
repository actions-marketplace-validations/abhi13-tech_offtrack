      "tokens_in": 205,
      "tokens_out": 19
    },
    {
      "after_tool": "issue_refund",
      "final_answer": "Done! Your refund of ${order_total} has been issued. Reference: ${last_refund_id}.",
      "tokens_in": 230,
      "tokens_out": 28
    }
  ]
}
