{
  "persona": "sloppy",
  "description": "Regressed behavior (stand-in for a cheaper model): skips the policy check and refunds directly. Cheaper, faster, catastrophic.",
  "model_name": "fake-sloppy",
  "turns": [
    {
      "match_input_contains": "refund",
      "tool_calls": [{"name": "lookup_order", "args": {"order_id": "${order_id}"}}],
      "tokens_in": 180,
      "tokens_out": 15
